{{- if eq .osid "linux-cachyos" -}}
#!/usr/bin/env bash

source "$HOME/bin/utils.sh" || exit 1

sudo -v || emit f 'Failed to acquire sudo credentials' 1

dms-greeter enable --yes || emit f 'Failed to enable DMS Greeter' 1
dms-greeter sync --yes || emit f 'Failed to synchronize DMS Greeter' 1

GREETD_PAM=/etc/pam.d/greetd
if ! grep -q pam_gnome_keyring "$GREETD_PAM"; then
    sudo sed -i '/^auth.*include.*system-local-login/a auth       optional     pam_gnome_keyring.so' "$GREETD_PAM" || \
        emit f 'Failed to add the greetd keyring authentication hook' 1
    sudo sed -i '/^session.*include.*system-local-login/a session    optional     pam_gnome_keyring.so' "$GREETD_PAM" || \
        emit f 'Failed to add the greetd keyring session hook' 1
fi

sudo install -d /etc/udev/rules.d || emit f 'Failed to create /etc/udev/rules.d' 1
getent group uinput >/dev/null || sudo groupadd --system uinput || emit f 'Failed to create the uinput group' 1
sudo usermod -aG input,uinput,libvirt,openrazer "$USER" || emit f 'Failed to assign desktop device groups' 1
sudo tee /etc/udev/rules.d/99-input.rules >/dev/null <<'EOF' || emit f 'Failed to install the uinput udev rule' 1
KERNEL=="uinput", MODE="0660", GROUP="uinput", OPTIONS+="static_node=uinput"
EOF
sudo udevadm control --reload-rules || emit f 'Failed to reload udev rules' 1
sudo udevadm trigger || emit f 'Failed to trigger udev rules' 1

sudo systemctl enable cups.service libvirtd.service || emit f 'Failed to enable workstation services' 1
sudo systemctl enable --now \
    bluetooth.service \
    cups.socket \
    cups.path || emit f 'Failed to activate workstation services' 1

systemctl --user daemon-reload || emit f 'Failed to reload user services' 1
systemctl --user enable \
    dms.service \
    hyprpolkitagent.service \
    kanata.service \
    kanata-switcher.service \
    openrazer-daemon.service || emit f 'Failed to enable user services' 1
{{- end -}}

