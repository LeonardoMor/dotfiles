{{- if eq .chezmoi.hostname "infinity" -}}
#!/usr/bin/env bash

case ${1:-} in
    plasma|desktop)
        systemctl --user --no-block stop gamescope-session.target
        ;;
    *)
        exec /usr/bin/steamos-session-select "$@"
        ;;
esac
{{- end -}}

