{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash

source -p ~/bin utils.sh || exit 1

ARGS=("$@")
COMMAND=
PREVIEW=false
DRY_RUN=false
HELP=false
UNSAFE_SYNC_PREVIEW=false
UNSAFE_EDIT_PREVIEW=false
HAS_MODULE=false
for arg in "$@"; do
    case $arg in
        --dry-run)
            PREVIEW=true
            DRY_RUN=true
            ;;
        --diff|--preview|--validate-only) PREVIEW=true ;;
        -h|--help|-V) HELP=true ;;
        --version) [[ $COMMAND = self-update ]] || HELP=true ;;
        upgrade|cache) UNSAFE_SYNC_PREVIEW=true ;;
        --create|--auto-format) UNSAFE_EDIT_PREVIEW=true ;;
        --module|--module=*|-m|-m?*) HAS_MODULE=true ;;
        install|sync|switch|edit|init|info|search|lint|help|self-update)
            [[ -n $COMMAND ]] || COMMAND=$arg
            ;;
    esac
    if [[ $COMMAND = edit && $arg =~ ^-[vqyfpcbh]+$ ]]; then
        [[ $arg != *p* ]] || PREVIEW=true
        [[ $arg != *c* ]] || UNSAFE_EDIT_PREVIEW=true
        [[ $arg != *h* ]] || HELP=true
    fi
done

if $PREVIEW && ! $HELP; then
    # Upstream ignores dry-run on these paths, or writes before checking it.
    case $COMMAND in
        init) emit e 'Declarch init does not honor dry-run; no command was run.' 2 ;;
        self-update) emit e 'Declarch self-update does not honor dry-run; no command was run.' 2 ;;
        sync) $UNSAFE_SYNC_PREVIEW && emit e 'Declarch upgrade/cache do not honor dry-run; no command was run.' 2 ;;
        edit) $UNSAFE_EDIT_PREVIEW && emit e 'Declarch create/auto-format can write during previews; no command was run.' 2 ;;
    esac
    # --diff alone can execute native sync hooks. Force a real dry-run as well.
    if ! $DRY_RUN; then
        ARGS=(--dry-run "${ARGS[@]}")
    fi
fi

# Do not let install add imports to the generated root config.
if [[ $COMMAND = install ]] && ! $HAS_MODULE; then
    ARGS+=(--module {{ .chezmoi.os | quote }})
fi

DECLARCH_DEFER_COMMIT=1 declarch "${ARGS[@]}"
RESULT=$?
if ! $PREVIEW && ! $HELP; then
    case $COMMAND in
        install|sync|switch|edit|init)
            chezmoi-declarch-commit || {
                ((RESULT != 0)) || RESULT=1
            }
            ;;
    esac
fi
exit "$RESULT"
{{- end }}
