{{ if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash

# Usage in Steam launch options:
#   rungame %command%

source -p ~/bin utils.sh || exit 1

PRE_STATUS_HOLDER=
PREDND=

FIXED_WRAPPERS=(
    game-performance
    prime-run
)

in-hyprland() {
    [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]
}

hyprexec() {
    hyprctl dispatch exec -- "$@"
}

calculate-current-DnD() {
    local status_holder=$1 retries=10

    : >"$status_holder" || return 1
    hyprexec DNDSTATUS="$status_holder" DnD get || return 1

    until [[ -s $status_holder || $retries == 0 ]]; do
        sleep 1
        ((retries--))
    done

    [[ -s $status_holder ]]
}

pre() {
    in-hyprland || return 0

    PRE_STATUS_HOLDER=$(mktemp /tmp/DnD.pre.XXX) || {
        emit w 'Unable to create DnD state holder'
        return 0
    }

    calculate-current-DnD "$PRE_STATUS_HOLDER" || return 0
    PREDND=$(<"$PRE_STATUS_HOLDER")
    [[ $PREDND == true ]] || hyprexec dms ipc notifications toggleDoNotDisturb
}

post() {
    local post_status_holder=

    if in-hyprland; then
        hyprctl reload || emit w 'Hyprland reload failed'
        post_status_holder=$(mktemp /tmp/DnD.post.XXX) || post_status_holder=

        if [[ -n $PREDND && -n $post_status_holder ]] && calculate-current-DnD "$post_status_holder"; then
            [[ $PREDND == "$(<"$post_status_holder")" ]] || hyprexec dms ipc notifications toggleDoNotDisturb
        fi
    fi

    [[ -z $PRE_STATUS_HOLDER ]] || rm -f "$PRE_STATUS_HOLDER"
    [[ -z $post_status_holder ]] || rm -f "$post_status_holder"
}

main() {
    local -a cmd=("${FIXED_WRAPPERS[@]}")

    trap post EXIT INT TERM

    cmd+=(
        scopebuddy
        --
        "$@"
    )

    "${cmd[@]}"
}

pre
main "$@"
{{- end -}}

