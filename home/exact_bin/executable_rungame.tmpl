{{ if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash

# Usage in Steam launch options:
#   rungame %command%

source -p ~/bin utils.sh || exit 1

PREDND=

FIXED_WRAPPERS=(
    game-performance
    prime-run
)

in-hyprland() {
    [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]
}

pre() {
    in-hyprland || return 0

    PREDND=$(dms ipc notifications getDoNotDisturb) || {
        emit w 'Unable to read do-not-disturb state'
        PREDND=
        return 0
    }

    [[ $PREDND == true ]] || dms ipc notifications toggleDoNotDisturb || {
        emit w 'Unable to enable do-not-disturb'
    }
}

post() {
    local post_dnd=

    in-hyprland || return 0
    [[ -n $PREDND ]] || return 0

    post_dnd=$(dms ipc notifications getDoNotDisturb) || {
        emit w 'Unable to read do-not-disturb state'
        return 0
    }

    [[ $PREDND == "$post_dnd" ]] || dms ipc notifications toggleDoNotDisturb || {
        emit w 'Unable to restore do-not-disturb state'
    }
}

main() {
    local -a cmd=("${FIXED_WRAPPERS[@]}")

    cmd+=(
        scopebuddy
        --
        "$@"
    )

    "${cmd[@]}"
}

trap post EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

pre
main "$@"
{{- end -}}

