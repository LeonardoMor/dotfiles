{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "qml": {
      "command": [
        "qmlls6"
      ],
      "extensions": [
        ".qml"
      ]
    }
  },
  "mcp": {
    "lean-ctx": {
      "command": [
        "/usr/bin/lean-ctx"
      ],
      "enabled": true,
      "type": "local"
    }
  },
  "permission": {
    "bash": "deny",
    "glob": "deny",
    "grep": "deny",
    "read": "deny"
  },
  "plugins": [
    "/home/leo/.config/opencode/adapters/ponytail-v2",
    "superpowers@git+https://github.com/obra/superpowers.git"
  ]
}
