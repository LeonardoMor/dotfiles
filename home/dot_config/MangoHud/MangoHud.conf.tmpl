legacy_layout=false

# Compact, centered performance strip.
position=top-center
horizontal
horizontal_stretch=false
font_size=20
no_small_font
text_color=E5E7EB
background_alpha=0.65
background_color=111827
round_corners=6
horizontal_separator_color=4B5563

# Frame pacing first, then GPU, CPU, memory and display backend.
fps
fps_metrics=avg,0.01
frame_timing
frametime_color=6EE7B7

pci_dev=0:01:00.0
gpu_text=GPU
gpu_stats
gpu_core_clock
gpu_mem_clock
gpu_temp
gpu_power
gpu_color=6EE7B7

cpu_text=CPU
cpu_stats
cpu_mhz
cpu_temp
cpu_power
cpu_color=93C5FD

vram
vram_color=C4B5FD
ram
ram_color=F9A8D4
battery
battery_color=FDE68A
display_server

fps_limit_method=late
toggle_fps_limit=Shift_L+F1
fps_limit=0

output_folder=/home/leo
log_duration=30
autostart_log=0
log_interval=100
toggle_logging=Shift_L+F2

blacklist=pamac-manager,lact,ghb,bitwig-studio,ptyxis,yumex

no_display
{{/*
vim: filetype=gotmpl
*/}}
