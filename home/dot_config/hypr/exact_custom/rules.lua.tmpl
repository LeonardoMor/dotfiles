{{- $extMonitor := "" -}}
{{- if eq .monitorProfile "alienware" -}}
{{-   $extMonitor = "Dell Inc. AW2725D" -}}
{{- else if eq .monitorProfile "asus-vg248" -}}
{{-   $extMonitor = "ASUSTek COMPUTER INC VG248" -}}
{{- end -}}
{{ if ne $extMonitor "" -}}
hl.workspace_rule({ workspace = '2', monitor = 'desc:{{ $extMonitor }}' })
hl.workspace_rule({ workspace = '3', monitor = 'desc:{{ $extMonitor }}' })
hl.workspace_rule({ workspace = '4', monitor = 'desc:{{ $extMonitor }}' })
hl.workspace_rule({
  workspace = '5',
  monitor = 'desc:{{ $extMonitor }}',
  gaps_in = 0,
  gaps_out = 0,
  decorate = false,
  no_rounding = true,
  no_border = true,
  no_shadow = true,
})
hl.workspace_rule({ workspace = '7', monitor = 'desc:{{ $extMonitor }}', persistent = true })

{{ end -}}
hl.window_rule({
  name = 'game-settings',
  match = {
    initial_class = '^(steam_app_\\d+)|(.*marvel.*)|(cyberpunk2077.exe)|(gamescope)$',
    title = 'negative:^(?i)(.*(Launcher|NetEase Game Security).*)$',
  },
  fullscreen = true,
  immediate = true,
  content = 'game',
  workspace = '5',
})

hl.window_rule({
  name = 'steam-workspace',
  match = { initial_class = 'steam' },
  workspace = '4',
})

hl.window_rule({
  name = 'discord-workspace',
  match = { initial_class = 'discord' },
  workspace = '2',
})

hl.window_rule({
  name = 'browser-workspace',
  match = { initial_class = 'zen' },
  workspace = '3',
})

hl.window_rule({
  name = 'coding-workspace',
  match = { initial_class = 'com.mitchellh.ghostty' },
  workspace = '7',
})

hl.window_rule({
  name = 'Waydroid',
  match = { initial_class = 'Waydroid' },
  workspace = '6',
  fullscreen = true,
})
{{- /* vim: filetype=lua.gotmpl
*/ -}}
