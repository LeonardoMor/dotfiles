// Generated by Chezmoi. Edit packages in modules, not this file.
backends {
    "backends.kdl"
}

imports {
    "modules/base.kdl"
    "modules/coding.kdl"
    "modules/{{ .chezmoi.os }}.kdl"
    "modules/coding-{{ .chezmoi.os }}.kdl"
{{- if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "cachyos") }}
    "modules/cachyos.kdl"
{{- end }}
}

experimental {
    "enable-hooks"
}

policy {
    protected "bash" "git" "chezmoi" "declarch-bin" "paru" "pacman" "systemd" "linux-cachyos" "linux-cachyos-lts"
    orphans "keep"
    on_duplicate "error"
    on_conflict "error"
}

hooks {
    post-sync "chezmoi-declarch-commit" "--required"
    on-failure "chezmoi-declarch-commit" "--required"
{{- if eq .chezmoi.os "linux" }}
    post-sync "chezmoi-declarch-services" "--required"
{{- end }}
}
{{/*
vim: filetype=gotmpl
*/}}
